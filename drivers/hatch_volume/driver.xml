<devicedata>
  <name>Hatch Volume</name>
  <version/>
  <manufacturer>Finite Labs</manufacturer>
  <model>Hatch Volume</model>
  <creator>Derek Miller</creator>
  <small image_source="c4z">icons/device_sm.png</small>
  <large image_source="c4z">icons/device_lg.png</large>
  <control>lua_gen</control>
  <driver>DriverWorks</driver>
  <copyright>Copyright 2026 Finite Labs, LLC. All rights reserved.</copyright>
  <created>07/13/2026 12:00:00 PM</created>
  <modified/>
  <minimum_os_version>3.3.0</minimum_os_version>
  <composer_categories>
    <category>Lighting</category>
  </composer_categories>
  <config>
    <script file="driver.lua" jit="1"/>
    <documentation file="www/documentation/index.html"/>
    <properties>
      <!-- #ifdef DRIVERCENTRAL -->
      <property>
        <name>Cloud Settings</name>
        <type>LABEL</type>
        <default>Cloud Settings</default>
      </property>
      <property>
        <name>Cloud Status</name>
        <default/>
        <type>STRING</type>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Automatic Updates</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <default>On</default>
      </property>
      <!-- #endif -->
      <property>
        <name>Driver Settings</name>
        <type>LABEL</type>
        <default>Driver Settings</default>
      </property>
      <property>
        <name>Driver Status</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Driver Version</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Log Level</name>
        <type>DYNAMIC_LIST</type>
        <default>3 - Info</default>
      </property>
      <property>
        <name>Log Mode</name>
        <type>LIST</type>
        <default>Off</default>
        <items>
          <item>Off</item>
          <item>Print</item>
          <item>Log</item>
          <item>Print and Log</item>
        </items>
      </property>
      <!-- #ifdef DRIVERCENTRAL -->
      <property>
        <name>Support Code</name>
        <type>STRING</type>
        <default/>
        <description>Enter only a code from Finite Labs support. It opens the Lua window for an hour.</description>
        <password>true</password>
      </property>
      <property>
        <name>Cloud Monitoring</name>
        <type>LIST</type>
        <default>Enabled</default>
        <items>
          <item>Disabled</item>
          <item>Enabled</item>
        </items>
        <description>Sends memory and error reports to Finite Labs so we can fix driver problems.</description>
      </property>
      <!-- #endif -->
      <property>
        <name>Volume Settings</name>
        <type>LABEL</type>
        <default>Volume Settings</default>
      </property>
      <property>
        <name>Turn On Plays</name>
        <type>DYNAMIC_LIST</type>
        <default>(Select)</default>
        <description>Sound or favorite to start when this dimmer is turned on. Populated from the Hatch account once connected.</description>
      </property>
    </properties>
    <actions>
      <!-- #ifdef DRIVERCENTRAL -->
      <action>
        <name>Diagnostics Snapshot</name>
        <command>DiagnosticsSnapshot</command>
      </action>
      <!-- #endif -->
    </actions>
    <commands/>
  </config>
  <capabilities/>
  <proxies>
    <proxy proxybindingid="5001" primary="True" name="Hatch Volume">light_v2</proxy>
  </proxies>
  <connections>
    <connection>
      <id>5001</id>
      <facing>6</facing>
      <connectionname>Light</connectionname>
      <type>2</type>
      <consumer>False</consumer>
      <linelevel>False</linelevel>
      <classes>
        <class>
          <classname>LIGHT_V2</classname>
        </class>
      </classes>
    </connection>
    <connection>
      <id>5002</id>
      <facing>6</facing>
      <connectionname>Hatch Device</connectionname>
      <type>2</type>
      <consumer>True</consumer>
      <linelevel>False</linelevel>
      <classes>
        <class>
          <classname>HATCH_VOLUME</classname>
        </class>
      </classes>
      <hidden>False</hidden>
    </connection>
  </connections>
</devicedata>
